# FitMotion AI - Environment Configuration
# Copy file nay thanh .env va dien gia tri that vao.
# File .env KHONG duoc commit len Git.

# ── MySQL - dien thong tin MySQL cua ban ─────────────────────────
FITMOTION_MYSQL_HOST=127.0.0.1
FITMOTION_MYSQL_PORT=3306
FITMOTION_MYSQL_USER=root
FITMOTION_MYSQL_PASSWORD=YOUR_PASSWORD_HERE
FITMOTION_MYSQL_DB=fitmotion_ai

# Hoac dung full URI (ghi de cac bien tren):
# FITMOTION_MYSQL_URI=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/fitmotion_ai?charset=utf8mb4

# ── Buoc dung SQLite (khong can MySQL) ──────────────────────────
# FITMOTION_FORCE_SQLITE=true
# Flask session secret - thay bằng chuỗi ngẫu nhiên dài khi deploy public
FITMOTION_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
